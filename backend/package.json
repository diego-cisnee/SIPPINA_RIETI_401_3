{
  "name": "rieti-backend",
  "version": "1.0.0",
  "description": "API básica para conectar el dashboard RIETI con MySQL en AWS RDS.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "test:auth-browser": "node ../aplicacion_web/work/test-auth.cjs",
    "test:reports-browser": "node ../aplicacion_web/work/test-report-actions.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "mysql2": "^3.22.1",
    "session-file-store": "^1.5.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "private": true
}
