# Puerto local de la API.
PORT=3000

# Origen autorizado para el prototipo web local.
CORS_ORIGIN=http://127.0.0.1:4173

# Datos de conexión proporcionados por el responsable de AWS RDS.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Secreto privado para firmar cookies y cifrar sesiones. Generar uno por entorno.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Apertura temporal del registro público: fecha ISO futura; vacío mantiene acceso solo admin.
# Al llegar a esta fecha se cierra automáticamente, sin reiniciar.
PUBLIC_ADMIN_REGISTRATION_UNTIL=

# Opcional: directorio persistente de sesiones (por defecto backend/.sessions).
# SESSION_DIR=

# En EC2 usar NODE_ENV=production, HTTPS y la CA de RDS.
# NODE_ENV=production
# DB_SSL_CA_FILE=/ruta/al/global-bundle.pem
